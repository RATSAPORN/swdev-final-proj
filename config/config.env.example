PORT=5000
NODE_ENV=development
# Atlas: replace the placeholders with your database user and cluster host.
# URL-encode special characters in the username/password. Keep the database name.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/massage-reservation?retryWrites=true&w=majority
# Select the existing Atlas database independently of the URI's old database name.
MONGO_DB=SW_DEV
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=1

# ---- Additional requirements (AR4–AR6): LINE. Leave blank to use mock login / dry-run messages. ----
# LINE Login channel (same provider as the Messaging API channel!)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Must exactly match a Callback URL registered in the LINE Login channel, e.g. http://localhost:5000/api/v1/line/callback
LINE_LOGIN_CALLBACK_URL=
# normal | aggressive (default aggressive): how LINE asks the user to add the Official Account as a friend
LINE_BOT_PROMPT=
# Messaging API channel access token (long-lived). Blank = dry-run: messages are printed, not sent.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Optional "add friend" link shown after linking, e.g. https://lin.ee/xxxxxxx
LINE_OA_ADD_FRIEND_URL=
# true = fake LINE Login for local demos/tests (ignored when NODE_ENV=production)
LINE_MOCK_LOGIN=
# ---- AR5: reminders ----
REMINDER_MINUTES_BEFORE=60
REMINDER_POLL_SECONDS=60
# false disables the scheduler
REMINDER_ENABLED=
