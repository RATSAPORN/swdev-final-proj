PORT=5000
NODE_ENV=development
# Atlas: replace the placeholders with your database user and cluster host.
# URL-encode special characters in the username/password. Keep the database name.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/massage-reservation?retryWrites=true&w=majority
# Select the existing Atlas database independently of the URI's old database name.
MONGO_DB=SW_DEV
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=1
